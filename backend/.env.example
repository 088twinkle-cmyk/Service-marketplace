# ---------------------------------------------------------------------------
# Service Marketplace — backend environment variables
#
# Copy this file to `.env` in the same folder (`backend/`) and edit the values.
# Everything below has a safe development default, so the project also runs
# with no `.env` file at all.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# NEVER commit the real `.env` — it is already in `.gitignore`.
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
# Generate one for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Comma-separated browser origins allowed to call the API.
# In DEBUG, *.e2b.app / *.arena.dev preview hosts are allowed automatically.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# --- JWT -------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Throttling (DRF) ------------------------------------------------------
THROTTLE_ANON=60/min
THROTTLE_USER=1000/day
THROTTLE_LOGIN=10/min
THROTTLE_OTP=5/min

# --- Email / OTP -----------------------------------------------------------
# Console backend prints OTP emails to the runserver console (development).
# For real email use: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@marketplace.local
OTP_EXPIRY_MINUTES=10

# OTP security policy (shared by registration + login verification).
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS=5
PENDING_REGISTRATION_TTL_MINUTES=30
# Country code used to normalise locally-typed phone numbers (Nepal).
PHONE_DEFAULT_COUNTRY_CODE=+977

# --- WhatsApp OTP verification ---------------------------------------------
# Registration/login verification is delivered over WhatsApp through a
# provider-agnostic service (backend/whatsapp/). Delivery is DISABLED by
# default: with WHATSAPP_OTP_ENABLED=false the real Cloud API is never
# called — in DEBUG a clearly-labelled development provider simulates
# delivery so local flows work, and production answers with a "not
# configured" error until real credentials are provided.
WHATSAPP_OTP_ENABLED=false
# auto (default) | cloud (force the real Cloud API) | development (force the mock)
WHATSAPP_PROVIDER=auto

# Meta WhatsApp Cloud API credentials — NEVER commit real values.
# Create a system user/app at https://developers.facebook.com → WhatsApp →
# API Setup, then fill these in and set WHATSAPP_OTP_ENABLED=true.
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# The approved OTP template (must exist in the WhatsApp Business Manager).
# e.g. name "otp_verification", language "en_US" (or "en" / "ne").
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US

# The public WhatsApp business/verification number users receive messages
# from (display info only — not a credential or API key).
WHATSAPP_VERIFICATION_NUMBER=9843677123

# --- eSewa (Nepali payment gateway) ---------------------------------------
# Defaults point at the public eSewa *sandbox* test credentials.
# While the merchant code is EPAYTEST (or empty) and DJANGO_DEBUG=true, the
# sandbox verifier may mark a payment SUCCESS when the client sends
# `force_success: true`; this makes local development possible without
# merchant credentials. Configuring a real merchant code disables that
# override automatically, so production can never fake a payment.
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_SUCCESS_URL=http://localhost:5173/payments/esewa/success
ESEWA_FAILURE_URL=http://localhost:5173/payments/esewa/failure
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
ESEWA_TRUST_SANDBOX_SUCCESS=true

# --- Uploads & business rules ---------------------------------------------
MAX_UPLOAD_SIZE_MB=10
BOOKING_CANCEL_CUTOFF_HOURS=24
DEFAULT_SERVICE_RADIUS_KM=25

# --- Logging ---------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
