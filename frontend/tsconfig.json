{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      
     
      "expo-image": [
        "./src/shims/expo-image.tsx"
      ],
      "expo-image-picker": [
        "./src/shims/expo-image-picker.ts"
      ],
      "expo-location": [
        "./src/shims/expo-location.ts"
      ],
      "expo-constants": [
        "./src/shims/expo-constants.ts"
      ],
      "expo-file-system/legacy": [
        "./src/shims/expo-file-system-legacy.ts"
      ],
      "react-native-safe-area-context": [
        "./src/shims/react-native-safe-area-context.tsx"
      ],
      "react-native-reanimated": [
        "./src/shims/react-native-reanimated.tsx"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "extends": "expo/tsconfig.base"
}
